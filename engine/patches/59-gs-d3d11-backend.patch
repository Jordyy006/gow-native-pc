+    bool makeDummySrvs()
+    {
+        const auto mk2D = [&](DXGI_FORMAT fmt, uint32_t w, uint32_t h, Com<ID3D11Texture2D> &tex, Com<ID3D11ShaderResourceView> &srv,
+                              const void *data, uint32_t pitch)
+        {
+            D3D11_TEXTURE2D_DESC td{};
+            td.Width = w;
+            td.Height = h;
+            td.MipLevels = 1;
+            td.ArraySize = 1;
+            td.Format = fmt;
+            td.SampleDesc.Count = 1;
+            td.Usage = D3D11_USAGE_DEFAULT;
+            td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+            D3D11_SUBRESOURCE_DATA init{};
+            init.pSysMem = data;
+            init.SysMemPitch = pitch;
+            if (FAILED(device->CreateTexture2D(&td, data ? &init : nullptr, tex.put())))
+                return false;
+            return SUCCEEDED(device->CreateShaderResourceView(tex.get(), nullptr, srv.put()));
+        };
+        const uint32_t oneRgba[] = {0xFF000000u};
+        const uint16_t oneR16[] = {0};
+        const uint16_t oneRg[2] = {0, 0};
+        for (int i = 0; i < 8; ++i)
+        {
+            // unused-slot dummies are never sampled; they only keep the resource-unit binding well formed.
+            DXGI_FORMAT fmt = DXGI_FORMAT_R8G8B8A8_UNORM;
+            const void *data = oneRgba;
+            uint32_t pitch = 4;
+            if (i == 2)
+            {
+                fmt = DXGI_FORMAT_R16_UINT;
+                data = oneR16;
+                pitch = 2;
+            }
+            if (i == 6)
+            {
+                fmt = DXGI_FORMAT_R16G16_UINT;
+                data = oneRg;
+                pitch = 4;
+            }
+            if (!mk2D(fmt, 1, 1, dummyTex[i], dummySrv[i], data, pitch))
+            {
+                std::fprintf(stderr, "[gs-hw-d3d11] dummy SRV %d failed\n", i);
+                return false;
+            }
+        }
+        return true;
+    }
