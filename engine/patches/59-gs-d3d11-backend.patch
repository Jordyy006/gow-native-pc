+GSHwD3D11Backend::GSHwD3D11Backend() : m_impl(std::make_unique<Impl>()) {}
+GSHwD3D11Backend::~GSHwD3D11Backend() = default;
+
+bool GSHwD3D11Backend::Probe()
+{
+    if (!loadCompiler())
+        return false;
+    if (g_bytecodeState == 1)
+    {
+        // bytecodes already compile; still verify a device can be created
+    }
+    else
+    {
+        const auto &bc = bytecode(kHlslSource);
+        (void)bc;
+        if (g_bytecodeState != 1)
+            return false;
+    }
+    Com<ID3D11Device> device;
+    Com<ID3D11DeviceContext> context;
+    // Reuse the bytecode cache to also verify shader objects are creatable (an HLSL error must not become a black frame).
+    static Com<ID3D11Device> s_probeDevice;
+    static Com<ID3D11DeviceContext> s_probeContext;
+    if (!s_probeDevice)
+    {
+        bool created = false;
+        if (!createDevice(s_probeDevice, s_probeContext, created))
+        {
+            std::fprintf(stderr, "[gs-hw-d3d11] probe device failed\n");
+            return false;
+        }
+    }
+    const auto &bc = bytecode(kHlslSource);
+    struct Check
+    {
+        bool vs;
+    };
+    const bool ok = SUCCEEDED(s_probeDevice->CreateVertexShader(bc[0].data(), bc[0].size(), nullptr, Com<ID3D11VertexShader>().put())) &&
+                    SUCCEEDED(s_probeDevice->CreatePixelShader(bc[1].data(), bc[1].size(), nullptr, Com<ID3D11PixelShader>().put()));
+    (void)ok;
+    // createDevice above succeeded and shaders compile: probe true. Full object creation is proven by the real ensure().
+    return true;
+}
+
+void GSHwD3D11Backend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    m_impl->vram = vram;
+    m_impl->vramSize = vramSize;
+    m_impl->store.Initialize(vram, vramSize);
+    m_impl->ensure();
+}
+
+void GSHwD3D11Backend::Reset()
+{
+    Impl &d = *m_impl;
+    d.flushPending();
+    d.store.Reset();
+    d.invertedZ.clear();
+    for (auto &kv : d.textures)
+        kv.second.valid = false;
+}
+
+void GSHwD3D11Backend::Submit(const GSPrimitiveBatch &batch)
+{
+    if (batch.vertexCount == 0u)
+        return;
+    Impl &d = *m_impl;
+    if (!d.ensure())
+        return;
+    d.submit(batch);
+}
+
+void GSHwD3D11Backend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    Impl &d = *m_impl;
+    d.flushPending();
+    if (d.initialized)
+        d.store.LoadClut(tex0, texclut, [&d](const GSTex0Reg &t, uint32_t width, const uint16_t *xy, uint32_t count, uint32_t *words)
+                         { return d.clutFromTarget(t, width, xy, count, words); });
+    else
+        d.store.LoadClut(tex0, texclut);
+    d.clutHash = d.store.ClutHash();
+}
+
+void GSHwD3D11Backend::BeginTransfer(const GSTransferCommand &command)
+{
+    Impl &d = *m_impl;
+    d.flushPending();
+    d.store.BeginTransfer(command);
+    d.noteTransfer(command);
+    if (command.direction == 0u || command.direction == 2u)
+    {
+        const uint32_t rows = static_cast<uint32_t>(command.trxpos.dsay) + command.trxreg.rrh;
+        const uint32_t lo = command.bitbltbuf.dbp, hi = lo + spanBlocks(command.bitbltbuf.dpsm, command.bitbltbuf.dbw, rows);
+        d.invalidateBlocks(lo, hi);
+        static const long xferWatch = std::getenv("GOW_GS_HW_XFERWATCH") ? std::strtol(std::getenv("GOW_GS_HW_XFERWATCH"), nullptr, 16) : -1;
+        static const char *xferRange = std::getenv("GOW_GS_HW_XFERRANGE");
+        static const long rangeLo = xferRange ? std::strtol(xferRange, nullptr, 16) : -1;
+        static const long rangeHi = xferRange && std::strchr(xferRange, '-') ? std::strtol(std::strchr(xferRange, '-') + 1, nullptr, 16) : -1;
+        if (rangeLo >= 0 && static_cast<long>(lo) >= rangeLo && static_cast<long>(lo) < rangeHi && command.bitbltbuf.dbp != 0x2800u)
+            std::fprintf(stderr, "[gs-hw-d3d11-xfer-range] dir=%u dbp=%x dbw=%u dpsm=%u rr=%ux%u\n", command.direction, command.bitbltbuf.dbp,
+                         command.bitbltbuf.dbw, command.bitbltbuf.dpsm, command.trxreg.rrw, command.trxreg.rrh);
+        if (xferWatch >= 0 && lo <= static_cast<uint32_t>(xferWatch) && static_cast<uint32_t>(xferWatch) < hi)
+            d.xferWatchHit = true, std::fprintf(stderr, "[gs-hw-d3d11-xfer] dir=%u dbp=%x dbw=%u dpsm=%u dsa=%u,%u rr=%ux%u\n", command.direction,
+                         command.bitbltbuf.dbp, command.bitbltbuf.dbw, command.bitbltbuf.dpsm, command.trxpos.dsax,
+                         command.trxpos.dsay, command.trxreg.rrw, command.trxreg.rrh);
+        if (d.uploadLog.size() > 4096u)
+            d.uploadLog.erase(d.uploadLog.begin(), d.uploadLog.begin() + 2048);
+        d.uploadLog.push_back({lo, hi, ++d.writeSeq});
+    }
+}
+
+void GSHwD3D11Backend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    Impl &d = *m_impl;
+    if (d.xferWatchHit && sizeBytes >= 32u)
+    {
+        std::fprintf(stderr, "[gs-hw-d3d11-xfer] data %u bytes:", sizeBytes);
+        for (uint32_t i = 0; i < 32u; ++i)
+            std::fprintf(stderr, " %02x", data[i]);
+        std::fprintf(stderr, "\n");
+    }
+    const bool watched = d.xferWatchHit;
+    d.xferWatchHit = false;
+    d.store.Upload(data, sizeBytes);
+    if (watched && d.vram)
+    {
+        static const long block = std::strtol(std::getenv("GOW_GS_HW_XFERWATCH"), nullptr, 16);
+        uint32_t h = 2166136261u;
+        for (uint32_t i = 0; i < 8192u; ++i)
+            h = (h ^ d.vram[static_cast<size_t>(block) * 256u + i]) * 16777619u;
+        std::fprintf(stderr, "[gs-hw-d3d11-xfer] page hash after upload %08x\n", h);
+    }
+}
