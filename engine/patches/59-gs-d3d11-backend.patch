+    RenderTarget &target(uint32_t fbp, uint32_t fbw)
+    {
+        for (RenderTarget &t : targets)
+            if (t.fbp == fbp && t.fbw >= fbw)
+                return t;
+        static const bool rtLog = std::getenv("GOW_GS_HW_RTLOG") != nullptr;
+        if (rtLog)
+            std::fprintf(stderr, "[gs-hw-d3d11-rt] new/grow fbp=%u fbw=%u\n", fbp, fbw);
+        for (RenderTarget &t : targets) // grow an existing one
+            if (t.fbp == fbp)
+            {
+                destroy(t);
+                createTarget(t, fbp, fbw);
+                return t;
+            }
+        targets.emplace_back();
+        createTarget(targets.back(), fbp, fbw);
+        return targets.back();
+    }
+
+    void destroy(RenderTarget &t) { t = RenderTarget{}; }
+
+    void createTarget(RenderTarget &t, uint32_t fbp, uint32_t fbw)
+    {
+        t.fbp = fbp;
+        t.psm = 0;
+        t.fbw = std::max<uint32_t>(fbw, 1u);
+        t.pxW = t.fbw * 64u;
+        t.pxH = 512u;
+        t.glW = static_cast<uint32_t>(std::ceil(t.pxW * scale));
+        t.glH = static_cast<uint32_t>(std::ceil(t.pxH * scale));
+        D3D11_TEXTURE2D_DESC td{};
+        td.Width = t.glW;
+        td.Height = t.glH;
+        td.MipLevels = 1;
+        td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_DEFAULT;
+        td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+        device->CreateTexture2D(&td, nullptr, t.color.put());
+        device->CreateRenderTargetView(t.color.get(), nullptr, t.colorRtv.put());
+        device->CreateShaderResourceView(t.color.get(), nullptr, t.colorSrv.put());
+        const float clear[4] = {0, 0, 0, 0};
+        context->ClearRenderTargetView(t.colorRtv.get(), clear);
+        std::fprintf(stderr, "[gs-hw-d3d11] render target fbp=%u fbw=%u -> %ux%u\n", fbp, t.fbw, t.glW, t.glH);
+    }
