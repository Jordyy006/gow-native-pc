+    // ---- presentation (CPU readback) ----------------------------------------------------------------------------------
+    bool ensurePresentTarget(uint32_t w, uint32_t h)
+    {
+        if (presentTex && presentW == w && presentH == h)
+            return true;
+        presentTex.reset();
+        presentRtv.reset();
+        presentSrv.reset();
+        presentStaging.reset();
+        D3D11_TEXTURE2D_DESC td{};
+        td.Width = w;
+        td.Height = h;
+        td.MipLevels = 1;
+        td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_DEFAULT;
+        td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+        if (FAILED(device->CreateTexture2D(&td, nullptr, presentTex.put())))
+            return false;
+        if (FAILED(device->CreateRenderTargetView(presentTex.get(), nullptr, presentRtv.put())))
+            return false;
+        if (FAILED(device->CreateShaderResourceView(presentTex.get(), nullptr, presentSrv.put())))
+            return false;
+        td.Usage = D3D11_USAGE_STAGING;
+        td.BindFlags = 0;
+        td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (FAILED(device->CreateTexture2D(&td, nullptr, presentStaging.put())))
+            return false;
+        presentW = w;
+        presentH = h;
+        return true;
+    }
