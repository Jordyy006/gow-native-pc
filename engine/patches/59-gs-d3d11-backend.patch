+    bool ensureClutTargets()
+    {
+        if (clutTex)
+            return true;
+        D3D11_TEXTURE2D_DESC td{};
+        td.Width = 256;
+        td.Height = 1;
+        td.MipLevels = 1;
+        td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_DEFAULT;
+        td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+        if (FAILED(device->CreateTexture2D(&td, nullptr, clutTex.put())))
+            return false;
+        if (FAILED(device->CreateRenderTargetView(clutTex.get(), nullptr, clutRtv.put())))
+            return false;
+        {
+            // CopyResource from a texture needs a staging texture of the same size and format (not a buffer).
+            D3D11_TEXTURE2D_DESC sd = td;
+            sd.Usage = D3D11_USAGE_STAGING;
+            sd.BindFlags = 0;
+            sd.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+            if (FAILED(device->CreateTexture2D(&sd, nullptr, clutStaging.put())))
+                return false;
+        }
+        td.Width = 256;
+        td.Height = 1;
+        td.Format = DXGI_FORMAT_R16G16_UINT;
+        td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        if (FAILED(device->CreateTexture2D(&td, nullptr, clutCoordTex.put())))
+            return false;
+        return SUCCEEDED(device->CreateShaderResourceView(clutCoordTex.get(), nullptr, clutCoordSrv.put()));
+    }
