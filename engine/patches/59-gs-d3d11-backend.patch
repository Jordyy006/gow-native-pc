+// GOW-Port: Direct3D 11 variant of the native GS renderer (see gs_hw_backend.h). It rasterises the same PS2 draws into
+// scaled RGBA render targets, decodes textures from the uploaded bytes and composes the two read circuits on the GPU,
+// then hands the composed frame to the host as tightly packed RGBA pixels. Selected with PS2X_GS_BACKEND=d3d11.
+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+
+#include <memory>
+
+class GSHwD3D11Backend final : public GSRasterBackend
+{
+public:
+    GSHwD3D11Backend();
+    ~GSHwD3D11Backend() override;
+
+    // True when a D3D11 device and d3dcompiler_47.dll can be created on this machine (used to fall back to OpenGL).
+    static bool Probe();
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+    // GOW-Port: this backend always reads the composed frame back, the host does not share a GL texture with it.
+    bool UsesSharedPresentation() const override { return false; }
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+};
diff --git a/PS2Recomp/ps2xRuntime/src/lib/gs/gpu/gs_hw_d3d11.cpp b/PS2Recomp/ps2xRuntime/src/lib/gs/gpu/gs_hw_d3d11.cpp
new file mode 100644
index 0000000..ddff2b7
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/src/lib/gs/gpu/gs_hw_d3d11.cpp
@@ -0,0 +1,3264 @@
+// GOW-Port: Direct3D 11 variant of the native GS renderer (see gs_hw_backend.cpp). Same PS2 draw translation into
+// scaled RGBA render targets, CPU texture decode and CLUT store reuse; the rasteriser, blend, depth and composition
+// are D3D11. Selected with PS2X_GS_BACKEND=d3d11; the host always reads the composed frame back.
+#include "runtime/gs/gs_hw_d3d11.h"
+
+#include "gs_texture_store.h"
+#include "runtime/gs/gs_swizzle.h"
+#include "../gs_gpu_helpers.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <d3d11.h>
+
+namespace
+{
+    // Minimal COM RAII: put()/reset()/get()/move own one interface pointer.
+    template <typename T>
+    struct Com
+    {
+        T *p = nullptr;
+        Com() = default;
+        ~Com() { reset(); }
+        Com(const Com &) = delete;
+        Com &operator=(const Com &) = delete;
+        Com(Com &&o) noexcept : p(o.p) { o.p = nullptr; }
+        Com &operator=(Com &&o) noexcept
+        {
+            if (this != &o)
+            {
+                reset();
+                p = o.p;
+                o.p = nullptr;
+            }
+            return *this;
+        }
+        void reset()
+        {
+            if (p)
+            {
+                p->Release();
+                p = nullptr;
+            }
+        }
+        T *get() const { return p; }
+        T *operator->() const { return p; }
+        explicit operator bool() const { return p != nullptr; }
+        T **put()
+        {
+            reset();
+            return &p;
+        }
+    };
+
+    // D3DCompile's include-handler parameter is ID3DInclude (defined in d3dcommon.h, pulled in by d3d11.h);
+    // there is no ID3D11Include type in the Windows SDK.
+    using D3DCompileFn = HRESULT(WINAPI *)(LPCVOID, SIZE_T, LPCVOID, const D3D_SHADER_MACRO *, ID3DInclude *, LPCSTR, LPCSTR, UINT, UINT, ID3DBlob **, ID3D10Blob **);
+#ifndef D3DCOMPILE_OPTIMIZATION_LEVEL3
+#define D3DCOMPILE_OPTIMIZATION_LEVEL3 (1 << 15)
+#endif
+
+    HMODULE g_d3dcompiler = nullptr;
+    D3DCompileFn g_compile = nullptr;
+
+    bool loadCompiler()
+    {
+        if (g_compile)
+            return true;
+        if (!g_d3dcompiler)
+            g_d3dcompiler = LoadLibraryW(L"d3dcompiler_47.dll");
+        if (!g_d3dcompiler)
+            return false;
+        g_compile = reinterpret_cast<D3DCompileFn>(GetProcAddress(g_d3dcompiler, "D3DCompile"));
+        return g_compile != nullptr;
+    }
+
+    bool compileAll(const char *source, std::vector<std::vector<uint8_t>> &cache)
+    {
+        struct Entry
+        {
+            const char *entry;
+            const char *profile;
+        };
+        static const Entry entries[] = {
+            {"vsDraw", "vs_5_0"}, {"psDraw", "ps_5_0"}, {"vsShuffle", "vs_5_0"}, {"psShuffle", "ps_5_0"},
+            {"vsFull", "vs_5_0"}, {"psPresent", "ps_5_0"}, {"psClut", "ps_5_0"}, {"psSolid", "ps_5_0"},
+        };
+        cache.clear();
+        cache.resize(8);
+        bool allOk = true;
+        for (size_t i = 0; i < 8; ++i)
+        {
+            ID3DBlob *blob = nullptr;
+            ID3D10Blob *errors = nullptr;
+            const HRESULT hr = g_compile(source, std::strlen(source), nullptr, nullptr, nullptr, entries[i].entry, entries[i].profile,
+                                         D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &blob, &errors);
+            if (FAILED(hr) || !blob)
+            {
+                if (errors && errors->GetBufferSize())
+                    std::fprintf(stderr, "[gs-hw-d3d11] HLSL %s error: %.*s\n", entries[i].entry,
+                                 static_cast<int>(errors->GetBufferSize()), static_cast<const char *>(errors->GetBufferPointer()));
+                if (blob)
+                    blob->Release();
+                if (errors)
+                    errors->Release();
+                allOk = false;
+                continue;
+            }
+            const SIZE_T size = blob->GetBufferSize();
+            const void *data = blob->GetBufferPointer();
+            cache[i].assign(static_cast<const uint8_t *>(data), static_cast<const uint8_t *>(data) + size);
+            blob->Release();
+            if (errors)
+                errors->Release();
+        }
+        return allOk;
+    }
+
+    std::vector<std::vector<uint8_t>> g_bytecode;
+    int g_bytecodeState = 0; // 0 not tried, 1 ok, -1 failed
+
+    const std::vector<std::vector<uint8_t>> &bytecode(const char *source)
+    {
+        if (g_bytecodeState == 0)
+        {
+            if (!loadCompiler())
+            {
+                std::fprintf(stderr, "[gs-hw-d3d11] d3dcompiler_47.dll unavailable\n");
+                g_bytecodeState = -1;
+            }
+            else if (!compileAll(source, g_bytecode))
+                g_bytecodeState = -1;
+            else
+                g_bytecodeState = 1;
+        }
+        return g_bytecode;
+    }
+
+    // HLSL shared by every entry. The draw cbuffer uses explicit float4/int4 groups with #define aliases matching the
+    // GLSL uniform names so the pixel shader below can stay a near one-to-one port of the GL fragment shader.
+    // HLSL gotcha: Load on a Texture2D returns float4 (color) / uint (Texture2D<uint>) / uint2, never a scalar vector
+    // the GLSL texelFetch returns; all ports below use the matching component.
+    const char *kHlslSource = R"HLSL(
+cbuffer CbDraw : register(b0)
+{
+    float4 F0; // invW, invH, texDimW, texDimH
+    float4 F1; // texSizeW, texSizeH, blendScale, fix
+    float4 F2; // zAliasMax, zMax, ta0, ta1
+    float4 F3; // rtPxW, rtPxH, scale, 0
+    int4   I0; // tme, fst, tfx, tcc
+    int4   I1; // iip, indexed, linear, rtTex24
+    int4   I2; // aem, date, datm, swBlend
+    int4   I3; // colClamp, zAlias, zAliasWrite, zTex
+    int4   I4; // abcd
+    int4   I5; // wrapX, wrapY, failTint, pass
+    int4   I6; // texFmt
+    int4   I7; // texFmt2
+    int4   I8; // rtFmt
+    int4   I9; // rtFmt2
+    int4   I10; // tex0
+    int4   I11; // ate, atst, aref, reinterp
+};
+#define uInvSize   (F0.xy)
+#define uTexDim    (F0.zw)
+#define uTexSize   (F1.xy)
+#define uBlendScale (F1.z)
+#define uFix       (F1.w)
+#define uZAliasMax (F2.x)
+#define uZMax      (F2.y)
+#define uTa0       (F2.z)
+#define uTa1       (F2.w)
+#define uRtPx      (F3.xy)
+#define uScale     (F3.z)
+#define uTme       (I0.x)
+#define uFst       (I0.y)
+#define uTfx       (I0.z)
+#define uTcc       (I0.w)
+#define uIip       (I1.x)
+#define uIndexed   (I1.y)
+#define uLinear    (I1.z)
+#define uRtTex24   (I1.w)
+#define uAem       (I2.x)
+#define uDate      (I2.y)
+#define uDatm      (I2.z)
+#define uSwBlend   (I2.w)
+#define uColClamp  (I3.x)
+#define uZAlias    (I3.y)
+#define uZAliasWrite (I3.z)
+#define uZTex      (I3.w)
+#define uAbcd      (I4)
+#define uWrap      (I5.xy)
+#define uFailTint  (I5.z)
+#define uPass      (I5.w)
+#define uTexFmt    (I6)
+#define uTexFmt2   (I7)
+#define uRtFmt     (I8)
+#define uRtFmt2    (I9)
+#define uTex0      (I10)
+#define uAte       (I11.x)
+#define uAtst      (I11.y)
+#define uAref      (I11.z)
+#define uReinterp  (I11.w)
+
+cbuffer CbShuffle : register(b1)
+{
+    float4 S0; // invW, invH, scale, zMax
+    int4   SI0; // srcZ, hs, hd, aem
+    int4   SI1; // ta0>>7, ta1>>7, 0, 0
+};
+#define sInvSize  (S0.xy)
+#define sScale    (S0.z)
+#define sZMax     (S0.w)
+#define sSrcZ     (SI0.x)
+#define sHs       (SI0.y)
+#define sHd       (SI0.z)
+#define sAem      (SI0.w)
+#define sTa0      (SI1.x)
+#define sTa1      (SI1.y)
+
+cbuffer CbPresent : register(b2)
+{
+    float4 PI0; // offX, offY, ct24, alphaX2
+    float4 PI1; // edge
+};
+#define pOff   (PI0.xy)
+#define pCt24  (PI0.z)
+#define pAlphaX2 (PI0.w)
+#define pEdge  (PI1.x)
+
+cbuffer CbSolid : register(b3)
+{
+    float4 solidColor;
+};
+
+SamplerState sTex : register(s0);
+Texture2D uTex : register(t0);
+Texture2D uRtColor : register(t1);
+Texture2D<uint> uTables : register(t2);
+Texture2D uPalette : register(t3);
+Texture2D uDest : register(t4);
+Texture2D uIdxPalette : register(t5);
+Texture2D<uint2> uCoords : register(t6);
+Texture2D uSrc : register(t7);
+
+struct DrawIn
+{
+    float2 aPos : POSITION;
+    float aZ : TEXCOORD0;
+    float4 aCol : COLOR;
+    float3 aSTQ : TEXCOORD1;
+    float2 aUV : TEXCOORD2;
+    float4 aUVClamp : TEXCOORD3;
+};
+struct DrawOut
+{
+    float4 aPos : SV_Position;
+    float4 vCol : TEXCOORD0;
+    float4 vColFlat : TEXCOORD1;
+    float3 vSTQ : TEXCOORD2;
+    float2 vUV : TEXCOORD3;
+    float4 vUVClamp : TEXCOORD4;
+};
+// GL maps PV coordinates with y down into y up; D3D NDC +1 y lands on RT row 0, so the y axis is flipped here (x stays).
+DrawOut vsDraw(DrawIn i)
+{
+    DrawOut o;
+    float2 ndc;
+    ndc.x = i.aPos.x * uInvSize.x * 2.0 - 1.0;
+    ndc.y = 1.0 - 2.0 * i.aPos.y * uInvSize.y;
+    o.aPos = float4(ndc, i.aZ, 1.0);
+    o.vCol = i.aCol;
+    o.vColFlat = i.aCol;
+    o.vSTQ = i.aSTQ;
+    o.vUV = i.aUV;
+    o.vUVClamp = i.aUVClamp;
+    return o;
+}
+
+uint tab(uint i) { return uTables.Load(int3(int(i & 2047u), int(i >> 11), 0)); }
+
+float4 reinterpretTexel(int2 p)
+{
+    uint x = uint(p.x), y = uint(p.y);
+    uint psx = uint(uTexFmt.x), psy = uint(uTexFmt.y);
+    uint pagesPerRow = (uint(uTex0.y) * 64u) >> psx;
+    uint page = (uint(uTex0.x) >> 5) + (y >> psy) * pagesPerRow + (x >> psx);
+    uint entry = ((uint(uTex0.x) & 31u) << (psx + psy)) + ((y & ((1u << psy) - 1u)) << psx) + (x & ((1u << psx) - 1u));
+    uint pixelIndex = (page << uint(uTexFmt.z)) + tab(uint(uTexFmt2.z) + entry);
+    uint bitpos = (pixelIndex << uint(uTexFmt.w)) + uint(uTexFmt2.x);
+    uint B = uint(uRtFmt.w);
+    uint rtIdx = bitpos / B;
+    uint within = bitpos % B;
+    uint rtBase = uint(uRtFmt2.y) << uint(uRtFmt.z);
+    if (rtIdx < rtBase) return float4(1.0, 0.0, 1.0, 1.0);
+    uint rel = rtIdx - rtBase;
+    uint rpage = rel >> uint(uRtFmt.z);
+    uint inpage = rel & ((1u << uint(uRtFmt.z)) - 1u);
+    uint e = tab(uint(uRtFmt2.x) + inpage);
+    uint rpsx = uint(uRtFmt.x), rpsy = uint(uRtFmt.y);
+    uint fbw = uint(uRtFmt2.z);
+    uint px = (rpage % fbw) * (1u << rpsx) + (e & ((1u << rpsx) - 1u));
+    uint py = (rpage / fbw) * (1u << rpsy) + (e >> rpsx);
+    // GL samples (px+0.5)/uRtPx normalised; the host texture is ceil(rtPx*scale) so the host texel is floor((px+0.5)*hdW/uRtPx).
+    uint hdW, hdH;
+    uRtColor.GetDimensions(hdW, hdH);
+    int2 q = int2(min(uint(float(hdW) * (float(px) + 0.5) / max(uRtPx.x, 1.0)), hdW - 1u),
+                  min(uint(float(hdH) * (float(py) + 0.5) / max(uRtPx.y, 1.0)), hdH - 1u));
+    float4 c = uRtColor.Load(int3(q, 0)) * 255.0;
+    c = floor(c + 0.5);
+    uint word;
+    if (B == 32u)
+        word = uint(c.r) | (uint(c.g) << 8) | (uint(c.b) << 16) | (uint(c.a) << 24);
+    else
+        word = (c.a >= 128.0 ? 0x8000u : 0u) | ((uint(c.b) >> 3) << 10) | ((uint(c.g) >> 3) << 5) | (uint(c.r) >> 3);
+    uint bits = uint(uTexFmt2.y);
+    uint mask = (bits >= 32u) ? 0xFFFFFFFFu : ((1u << (bits & 31u)) - 1u);
+    uint value = (bits >= 32u) ? (word >> within) : ((word >> within) & mask);
+    int kind = uTexFmt2.w;
+    if (kind == 0) return float4(float(value & 255u), float((value >> 8) & 255u), float((value >> 16) & 255u), float((value >> 24) & 255u)) / 255.0;
+    if (kind == 1) return float4(float(value & 255u), float((value >> 8) & 255u), float((value >> 16) & 255u), 128.0) / 255.0;
+    if (kind == 2)
+    {
+        float3 rgb = float3(float(value & 31u), float((value >> 5) & 31u), float((value >> 10) & 31u)) * 8.0;
+        return float4(rgb, ((value & 0x8000u) != 0u) ? 128.0 : 0.0) / 255.0;
+    }
+    return uPalette.Load(int3(int(value & 255u), 0, 0));
+}
+
+float4 indexedTexel(int2 p)
+{
+    int2 size = max(int2(int(uTexDim.x), int(uTexDim.y)), int2(1, 1));
+    p.x = (uWrap.x == 0) ? ((p.x % size.x) + size.x) % size.x : clamp(p.x, 0, size.x - 1);
+    p.y = (uWrap.y == 0) ? ((p.y % size.y) + size.y) % size.y : clamp(p.y, 0, size.y - 1);
+    int idx = int(uTex.Load(int3(p, 0)).r * 255.0 + 0.5);
+    return uIdxPalette.Load(int3(idx, 0, 0));
+}
+
+float clamp255(float v) { return clamp(floor(v), 0.0, 255.0); }
+
+float3 blendSel(int sel, float3 cs, float3 cd) { return sel == 0 ? cs : sel == 1 ? cd : float3(0.0, 0.0, 0.0); }
+
+bool alphaPasses(float a)
+{
+    int ai = int(a);
+    switch (uAtst)
+    {
+    case 0: return false;
+    case 1: return true;
+    case 2: return ai < uAref;
+    case 3: return ai <= uAref;
+    case 4: return ai == uAref;
+    case 5: return ai >= uAref;
+    case 6: return ai > uAref;
+    default: return ai != uAref;
+    }
+}
+
+struct PsOut
+{
+    float4 oColor : SV_Target0;
+    float4 oBlend : SV_Target1;
+};
+
+// SV_Position first: it is register 0 of the VS outputs, and the interpolants must line up with them.
+PsOut psDraw(float4 pos : SV_Position, float4 vCol : TEXCOORD0, float4 vColFlat : TEXCOORD1, float3 vSTQ : TEXCOORD2, float2 vUV : TEXCOORD3, float4 vUVClamp : TEXCOORD4)
+{
+    PsOut o;
+    uint zFrag = uint(clamp(pos.z, 0.0, 1.0) * uZAliasMax + 0.5);
+    int2 fragPx = int2(pos.xy);
+    if (uZAlias != 0)
+    {
+        float4 d = floor(uDest.Load(int3(fragPx, 0)) * 255.0 + 0.5);
+        uint zd = uint(d.r) | (uint(d.g) << 8) | (uint(d.b) << 16);
+        int ztst = uZAlias - 1;
+        bool zpass = ztst == 1 || (ztst == 2 && zFrag >= zd) || (ztst == 3 && zFrag > zd);
+        if (!zpass) discard;
+    }
+    if (uDate != 0)
+    {
+        bool bit = uDest.Load(int3(fragPx, 0)).a >= 0.5;
+        if (bit != (uDatm != 0)) discard;
+    }
+    float4 v = (uIip != 0) ? vCol : vColFlat;
+    float3 rgb = v.rgb;
+    float a = v.a;
+    if (uTme != 0)
+    {
+        float q = (abs(vSTQ.z) < 1e-30) ? 1e-30 : vSTQ.z;
+        float2 uv = (uFst != 0) ? vUV : (vSTQ.xy / q) * uTexDim;
+        uv = clamp(uv, vUVClamp.xy, vUVClamp.zw);
+        if (uLinear == 0)
+            uv = floor(uv * 16.0 + 0.015625) / 16.0;
+        float4 t;
+        if (uReinterp != 0)
+        {
