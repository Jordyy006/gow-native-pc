+    RenderTarget *findReinterpretSource(uint32_t tbp, uint8_t tpsm)
+    {
+        const bool highByte = tpsm == GS_PSM_T8H || tpsm == GS_PSM_T4HL || tpsm == GS_PSM_T4HH;
