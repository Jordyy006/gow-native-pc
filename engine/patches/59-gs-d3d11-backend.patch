+    bool createDevice(Com<ID3D11Device> &device, Com<ID3D11DeviceContext> &context, bool &created)
+    {
+        created = false;
+        if (device)
+            return true;
+        const D3D_FEATURE_LEVEL levels[] = {D3D_FEATURE_LEVEL_11_0};
+        D3D_FEATURE_LEVEL got = D3D_FEATURE_LEVEL_11_0;
+        // GOW_GS_D3D11_DEBUG=1 asks for the D3D11 debug layer (needs the "Graphics Tools" Windows feature); its messages are
+        // printed after each present by dumpDebugMessages().
+        UINT flags = std::getenv("GOW_GS_D3D11_DEBUG") ? D3D11_CREATE_DEVICE_DEBUG : 0u;
+        // GOW_GS_D3D11_WARP=1 uses Microsoft's software rasteriser: only for tests on machines without a GPU (CI), far too slow to play.
+        const D3D_DRIVER_TYPE driverType = std::getenv("GOW_GS_D3D11_WARP") ? D3D_DRIVER_TYPE_WARP : D3D_DRIVER_TYPE_HARDWARE;
+        HRESULT hr = D3D11CreateDevice(nullptr, driverType, nullptr, flags, levels, 1, D3D11_SDK_VERSION,
+                                       device.put(), &got, context.put());
+        if (FAILED(hr) && flags)
+            hr = D3D11CreateDevice(nullptr, driverType, nullptr, 0, levels, 1, D3D11_SDK_VERSION,
+                                   device.put(), &got, context.put());
+        if (FAILED(hr) || got != D3D_FEATURE_LEVEL_11_0)
+        {
+            device.reset();
+            context.reset();
+            return false;
+        }
+        created = true;
+        return true;
+    }
