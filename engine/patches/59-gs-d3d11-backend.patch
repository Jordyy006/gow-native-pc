+    // GS blend factor codes: 0 Cs, 1 Cd, 2 zero, 3 fix? (alpha C selector mapping below). Returns D3D-friendly factors.
+    enum class Factor { SrcAlpha, OneMinusSrcAlpha, Src1Alpha, OneMinusSrc1Alpha, Constant, One, Zero };
+    enum class BlendOp { Add, RevSubtract };
+
+    void blendState(const GSDrawState &s, bool &enabled, Factor &sf, Factor &df, float &fixScale, float &constant, BlendOp &equation, bool &soft)
+    {
+        enabled = false;
+        soft = false;
+        equation = BlendOp::Add;
+        sf = Factor::One; df = Factor::Zero;
+        fixScale = 1.0f / 128.0f;
+        constant = 0.0f;
+        if (!s.prim.abe)
+            return;
+        const uint64_t alpha = s.context.alpha;
+        const uint32_t a = alpha & 3, b = (alpha >> 2) & 3, c = (alpha >> 4) & 3, d = (alpha >> 6) & 3;
+        const uint32_t fix = static_cast<uint32_t>((alpha >> 32) & 0xFF);
+        Factor cs, cd;
+        if (c == 0) { cs = Factor::Src1Alpha; cd = Factor::OneMinusSrc1Alpha; }
+        else if (c == 2) { cs = Factor::Constant; cd = Factor::Constant; constant = std::min(fix / 128.0f, 1.0f); }
+        else { soft = true; cs = Factor::Src1Alpha; cd = Factor::OneMinusSrc1Alpha; }
+        // wrap-around via shader (Cs - Cd with COLCLAMP=0 and A != B) is handled by uSwBlend when it cannot map.
+        if ((s.colclamp & 1u) == 0u && a != b)
+            soft = true;
+        if (a == b)
+        {
+            if (d == 0)
+                return; // plain write
+            if (d == 1)
+            { // Cd: destination unchanged
+                enabled = true; sf = Factor::Zero; df = Factor::One; return;
+            }
+            return;
+        }
+        enabled = true;
+        if (a == 0 && b == 1 && d == 1) { sf = cs; df = cd; }
+        else if (a == 0 && b == 2 && d == 1) { sf = cs; df = Factor::One; }
+        else if (a == 2 && b == 1 && d == 1) { sf = Factor::Zero; df = cd; }
+        else if (a == 0 && b == 2 && d == 2) { sf = cs; df = Factor::Zero; }
+        else if (a == 2 && b == 0 && d == 2) { sf = Factor::Zero; df = Factor::Zero; }
+        else if (a == 2 && b == 0 && d == 1) { sf = cs; df = Factor::One; equation = BlendOp::RevSubtract; }
+        else { soft = true; sf = cs; df = cd; }
+        if (soft)
+            ++stats.unsupportedBlend;
+    }
+
+    ID3D11BlendState *blendStateObj(bool enabled, Factor sf, Factor df, BlendOp equation, uint32_t writeMask, float constant, float wrapAmount[3])
+    {
+        const auto toFunc = [](Factor f)
+        {
+            switch (f)
+            {
+            case Factor::SrcAlpha: return D3D11_BLEND_SRC_ALPHA;
+            case Factor::OneMinusSrcAlpha: return D3D11_BLEND_INV_SRC_ALPHA;
+            case Factor::Src1Alpha: return D3D11_BLEND_SRC1_ALPHA;
+            case Factor::OneMinusSrc1Alpha: return D3D11_BLEND_INV_SRC1_ALPHA;
+            case Factor::Constant: return D3D11_BLEND_BLEND_FACTOR;
+            case Factor::One: return D3D11_BLEND_ONE;
+            case Factor::Zero: return D3D11_BLEND_ZERO;
+            }
+            return D3D11_BLEND_ONE;
+        };
+        const auto toOp = [](BlendOp op) { return op == BlendOp::RevSubtract ? D3D11_BLEND_OP_REV_SUBTRACT : D3D11_BLEND_OP_ADD; };
+        const D3D11_BLEND_OP op = toOp(equation);
+        const D3D11_BLEND src = toFunc(sf);
+        const D3D11_BLEND dst = toFunc(df);
+        uint32_t key = (writeMask & 0xFFu) | ((enabled ? 1u : 0u) << 8) | (static_cast<uint32_t>(op) << 9) |
+                       (static_cast<uint32_t>(src) << 12) | (static_cast<uint32_t>(dst) << 20);
+        // RenderTargetWriteMask per channel already excludes masked (fbmsk) channels; alpha uses ONE/ZERO.
+        auto it = blendCache.find(key);
+        if (it != blendCache.end())
+            return it->second.get();
+        D3D11_BLEND_DESC bd{};
+        bd.RenderTarget[0].BlendEnable = enabled ? TRUE : FALSE;
+        bd.RenderTarget[0].SrcBlend = src;
+        bd.RenderTarget[0].DestBlend = dst;
+        bd.RenderTarget[0].BlendOp = op;
+        bd.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ONE;
+        bd.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ZERO;
+        bd.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+        bd.RenderTarget[0].RenderTargetWriteMask = static_cast<UINT8>(writeMask);
+        Com<ID3D11BlendState> state;
+        if (FAILED(device->CreateBlendState(&bd, state.put())))
+            return nullptr;
+        auto inserted = blendCache.emplace(key, std::move(state)).first;
+        (void)constant;
+        (void)wrapAmount;
+        return inserted->second.get();
+    }
+
+    void applyBlend(bool enabled, Factor sf, Factor df, BlendOp equation, uint32_t writeMask, float constant, float wrapAmount[3], bool wrapCount)
+    {
+        ID3D11BlendState *state = blendStateObj(enabled, sf, df, equation, writeMask, constant, wrapAmount);
+        const float factor[4] = {wrapCount ? wrapAmount[0] : constant, wrapCount ? wrapAmount[1] : constant,
+                                 wrapCount ? wrapAmount[2] : constant, 0.0f};
+        context->OMSetBlendState(state, factor, 0xFFFFFFFF);
+    }
+
+    ID3D11DepthStencilState *depthStateObj(bool enable, D3D11_COMPARISON_FUNC func, bool write, uint32_t &keyOut)
+    {
+        const uint32_t key = (enable ? 1u : 0u) | (static_cast<uint32_t>(func) << 1) | (write ? (1u << 8) : 0u);
+        keyOut = key;
+        auto it = depthCache.find(key);
+        if (it != depthCache.end())
+            return it->second.get();
+        D3D11_DEPTH_STENCIL_DESC dd{};
+        dd.DepthEnable = enable ? TRUE : FALSE;
+        dd.DepthWriteMask = write ? D3D11_DEPTH_WRITE_MASK_ALL : D3D11_DEPTH_WRITE_MASK_ZERO;
+        dd.DepthFunc = func;
+        dd.StencilEnable = FALSE;
+        dd.FrontFace.StencilFunc = D3D11_COMPARISON_ALWAYS;
+        dd.FrontFace.StencilFailOp = D3D11_STENCIL_OP_KEEP;
+        dd.FrontFace.StencilDepthFailOp = D3D11_STENCIL_OP_KEEP;
+        dd.BackFace = dd.FrontFace;
+        Com<ID3D11DepthStencilState> state;
+        if (FAILED(device->CreateDepthStencilState(&dd, state.put())))
+            return nullptr;
+        auto inserted = depthCache.emplace(key, std::move(state)).first;
+        return inserted->second.get();
+    }
+
+    ID3D11SamplerState *samplerFor(bool linear, bool clamp)
+    {
+        if (linear && clamp)
+            return samplerLinearClamp.get();
+        if (linear)
+            return samplerLinearRepeat.get();
+        if (clamp)
+            return samplerPointClamp.get();
+        return samplerPointRepeat.get();
+    }
+
+    void ensureScratchColor(uint32_t w, uint32_t h)
+    {
+        if (scratchColorA && scratchColorW == w && scratchColorH == h && scratchColorB)
+            return;
+        const auto mk = [&](Com<ID3D11Texture2D> &tex, Com<ID3D11ShaderResourceView> &srv)
+        {
+            tex.reset();
+            srv.reset();
+            D3D11_TEXTURE2D_DESC td{};
+            td.Width = w;
+            td.Height = h;
