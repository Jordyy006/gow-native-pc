+    void dumpDebugMessages(ID3D11Device *device)
+    {
+        if (!std::getenv("GOW_GS_D3D11_DEBUG"))
+            return;
+        ID3D11InfoQueue *queue = nullptr;
+        if (FAILED(device->QueryInterface(__uuidof(ID3D11InfoQueue), reinterpret_cast<void **>(&queue))) || !queue)
+        {
+            std::fprintf(stderr, "[gs-hw-d3d11-debug] debug layer unavailable (install the Graphics Tools optional feature)\n");
+            return;
+        }
+        const UINT64 count = queue->GetNumStoredMessages();
+        for (UINT64 i = 0; i < count && i < 40; ++i)
+        {
+            SIZE_T len = 0;
+            queue->GetMessage(i, nullptr, &len);
+            std::vector<uint8_t> raw(len);
+            auto *msg = reinterpret_cast<D3D11_MESSAGE *>(raw.data());
+            if (SUCCEEDED(queue->GetMessage(i, msg, &len)))
+                std::fprintf(stderr, "[gs-hw-d3d11-debug] %s\n", msg->pDescription);
+        }
+        queue->ClearStoredMessages();
+        queue->Release();
+    }
