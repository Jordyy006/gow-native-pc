+        context->ClearRenderTargetView(presentRtv.get(), clear);
+        const uint32_t edge = static_cast<uint32_t>(std::lround(2.0f * scale));
+        const bool mmod = ((request.pmode >> 5) & 1u) != 0u, slbg = ((request.pmode >> 7) & 1u) != 0u;
+        const uint32_t alp = static_cast<uint32_t>((request.pmode >> 8) & 0xFFu);
+        const auto drawCircuit = [&](uint32_t cfbp, uint64_t dispfb, uint32_t cdbx, uint32_t cdby, bool alphaFactor, bool useBlend, float blendConstant)
+        {
+            RenderTarget *rt = findTarget(cfbp);
+            if (!rt)
+                return;
+            CbPresent cb{};
+            cb.PI0[0] = static_cast<float>(static_cast<int32_t>(cdbx * scale));
+            cb.PI0[1] = static_cast<float>(static_cast<int32_t>(cdby * scale));
+            cb.PI0[2] = ((dispfb >> 15) & 0x1Fu) == GS_PSM_CT24 ? 1.0f : 0.0f;
+            cb.PI0[3] = alphaFactor ? 1.0f : 0.0f;
+            cb.PI1[0] = static_cast<float>(edge);
+            context->UpdateSubresource(cbPresent.get(), 0, nullptr, &cb, 0, 0);
+            ID3D11Buffer *cbs[1] = {cbPresent.get()};
+            context->PSSetConstantBuffers(2, 1, cbs);
+            ID3D11ShaderResourceView *srvs[8] = {dummySrv[0].get(), dummySrv[1].get(), dummySrv[2].get(), dummySrv[3].get(),
+                                                dummySrv[4].get(), dummySrv[5].get(), dummySrv[6].get(), rt->colorSrv.get()};
+            context->PSSetShaderResources(0, 8, srvs);
+            D3D11_BLEND_DESC bd{};
+            bd.RenderTarget[0].SrcBlend = D3D11_BLEND_ONE;
+            bd.RenderTarget[0].DestBlend = D3D11_BLEND_ZERO;
+            bd.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+            bd.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ONE;
+            bd.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ZERO;
+            bd.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+            bd.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+            bd.RenderTarget[0].BlendEnable = useBlend ? TRUE : FALSE;
+            bd.RenderTarget[0].SrcBlend = D3D11_BLEND_ONE;
+            bd.RenderTarget[0].DestBlend = D3D11_BLEND_ZERO;
+            if (useBlend)
+            {
+                if (mmod)
+                {
+                    bd.RenderTarget[0].SrcBlend = D3D11_BLEND_BLEND_FACTOR;
+                    bd.RenderTarget[0].DestBlend = D3D11_BLEND_INV_BLEND_FACTOR;
+                }
+                else
+                {
+                    bd.RenderTarget[0].SrcBlend = D3D11_BLEND_SRC_ALPHA;
+                    bd.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+                }
+                bd.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+            }
+            bd.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+            Com<ID3D11BlendState> state;
+            device->CreateBlendState(&bd, state.put());
+            const float factor[4] = {blendConstant, blendConstant, blendConstant, blendConstant};
+            context->OMSetBlendState(state.get(), factor, 0xFFFFFFFF);
+            context->Draw(3, 0);
+            unbindSrvs();
+            context->OMSetBlendState(nullptr, factor, 0xFFFFFFFF);
+        };
+        if (ok1 && ok2)
+        {
+            if (slbg)
+            {
+                const float bg[4] = {static_cast<float>(request.bgcolor & 0xFFu) / 255.f, static_cast<float>((request.bgcolor >> 8) & 0xFFu) / 255.f,
+                                     static_cast<float>((request.bgcolor >> 16) & 0xFFu) / 255.f, 1.f};
+                context->ClearRenderTargetView(presentRtv.get(), bg);
+            }
+            else
+                drawCircuit(fbp2, request.dispfb2, dbx2, dby2, false, false, 0.0f);
+            const float f = static_cast<float>(alp) / 255.f;
+            drawCircuit(fbp1, request.dispfb1, dbx1, dby1, true, true, f);
+        }
+        else
+            drawCircuit(fbp, ok1 ? request.dispfb1 : request.dispfb2, ok1 ? dbx1 : dbx2, ok1 ? dby1 : dby2, false, false, 0.0f);
+        // Force opaque alpha (the host draws with blending; ClearRenderTargetView cannot target alpha alone).
+        {
+            const float opaque[4] = {0, 0, 0, 1.0f};
+            solidPass(opaque, true, outW, outH);
+        }
+        ID3D11RenderTargetView *noneRtv[1] = {nullptr};
+        context->OMSetRenderTargets(1, noneRtv, nullptr);
+        context->CopyResource(presentStaging.get(), presentTex.get());
+        D3D11_MAPPED_SUBRESOURCE mapped{};
+        if (SUCCEEDED(context->Map(presentStaging.get(), 0, D3D11_MAP_READ, 0, &mapped)))
+        {
+            // Staging row pitch may be padded, so copy row by row into the compact frame.
+            for (uint32_t y = 0; y < outH; ++y)
+            {
+                const uint8_t *srcRow = static_cast<const uint8_t *>(mapped.pData) + static_cast<size_t>(y) * mapped.RowPitch;
+                std::memcpy(frame.pixels.data() + static_cast<size_t>(y) * outW * 4u, srcRow, static_cast<size_t>(outW) * 4u);
+            }
+            context->Unmap(presentStaging.get(), 0);
+        }
+        if (frame.width < 640u)
+        {
+            std::vector<uint8_t> rows(static_cast<size_t>(640u) * frame.height * 4u, 0u);
+            for (uint32_t y = 0; y < frame.height; ++y)
+                std::memcpy(rows.data() + static_cast<size_t>(y) * 640u * 4u, frame.pixels.data() + static_cast<size_t>(y) * frame.width * 4u, static_cast<size_t>(frame.width) * 4u);
+            frame.pixels = std::move(rows);
+        }
+        unbindSrvs();
+        dumpDebugMessages(device.get());
+        return frame;
+    }
+
+    bool clearFramebuffer(const GSContext &ctx, uint32_t rgba)
+    {
+        if (!ensure() || ctx.frame.fbw == 0u)
+            return false;
+        flushPending();
+        RenderTarget &rt = target(ctx.frame.fbp, ctx.frame.fbw);
+        ID3D11RenderTargetView *rtv = rt.colorRtv.get();
+        context->OMSetRenderTargets(1, &rtv, nullptr);
+        D3D11_VIEWPORT vp{};
+        vp.MaxDepth = 1.0f;
+        vp.Width = static_cast<float>(rt.glW);
+        vp.Height = static_cast<float>(rt.glH);
+        context->RSSetViewports(1, &vp);
+        D3D11_RECT sc{};
+        const int sx0 = ctx.scissor.x0, sy0 = ctx.scissor.y0;
+        sc.left = static_cast<LONG>(std::floor(sx0 * scale));
+        sc.top = static_cast<LONG>(std::floor(sy0 * scale));
+        sc.right = sc.left + static_cast<LONG>(std::ceil((ctx.scissor.x1 - sx0 + 1) * scale));
+        sc.bottom = sc.top + static_cast<LONG>(std::ceil((ctx.scissor.y1 - sy0 + 1) * scale));
+        sc.left = std::max<LONG>(sc.left, 0);
+        sc.top = std::max<LONG>(sc.top, 0);
+        sc.right = std::min<LONG>(sc.right, static_cast<LONG>(rt.glW));
+        sc.bottom = std::min<LONG>(sc.bottom, static_cast<LONG>(rt.glH));
+        context->RSSetState(rastScissor.get());
+        context->RSSetScissorRects(1, &sc);
+        unbindSrvs();
+        const float color[4] = {(rgba & 0xFF) / 255.0f, ((rgba >> 8) & 0xFF) / 255.0f, ((rgba >> 16) & 0xFF) / 255.0f, ((rgba >> 24) & 0xFF) / 255.0f};
+        // ClearRenderTargetView cannot be scissored; use a scissored solid draw instead.
+        {
+            solidPass(color, false, rt.glW, rt.glH);
+        }
+        ID3D11RenderTargetView *noneRtv[1] = {nullptr};
+        context->OMSetRenderTargets(1, noneRtv, nullptr);
+        ++rt.version;
+        rt.lastDrawSeq = ++writeSeq;
+        return true;
+    }
+};
