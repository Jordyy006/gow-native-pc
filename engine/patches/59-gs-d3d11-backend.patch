+    void dumpSkipped(const GSDrawState &s, const GSPrimitiveBatch &b, const char *why)
+    {
+        if (dumpPresents < 0 || presentCount < dumpPresents || presentCount >= dumpPresents + 3 || dumped >= dumpMax)
+            return;
+        flushPending();
+        ++dumped;
+        dumpAfterSkip = true;
+        const GSContext &c = s.context;
+        const GSVertex &v0 = b.vertices[0], &v1 = b.vertices[1];
+        std::fprintf(stderr,
+                     "[gs-hw-d3d11-skip] #%d %s why=%d prim=%d fbp=%u fbw=%u fpsm=%u fbmsk=%x zbp=%x zmsk=%d tme=%d tbp=%x tbw=%u tpsm=%u %ux%u cbp=%x test=%llx alpha=%llx abe=%d v0=(%.1f,%.1f uv=%u,%u col=%u,%u,%u,%u) v1=(%.1f,%.1f uv=%u,%u) scis=%u-%u,%u-%u\n",
+                     dumped, why, shuffleWhy, static_cast<int>(s.prim.type), c.frame.fbp, c.frame.fbw, c.frame.psm, c.frame.fbmsk, c.zbuf.zbp, c.zbuf.zmask ? 1 : 0,
+                     s.prim.tme ? 1 : 0, c.tex0.tbp0, c.tex0.tbw, c.tex0.psm, s.textureWidth, s.textureHeight, c.tex0.cbp,
+                     (unsigned long long)c.test, (unsigned long long)c.alpha, s.prim.abe ? 1 : 0, v0.x, v0.y, v0.u, v0.v,
+                     (unsigned)v0.r, (unsigned)v0.g, (unsigned)v0.b, (unsigned)v0.a, v1.x, v1.y, v1.u, v1.v, c.scissor.x0, c.scissor.x1, c.scissor.y0, c.scissor.y1);
+    }
